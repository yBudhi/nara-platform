NARA_ENV=poc

POSTGRES_DB=nara
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

NARA_OWNER_USER=nara_owner

NARA_MIGRATOR_USER=nara_migrator
NARA_MIGRATOR_PASSWORD=CHANGE_ME_MIGRATOR_PASSWORD

NARA_RUNTIME_USER=nara_runtime
NARA_RUNTIME_PASSWORD=CHANGE_ME_RUNTIME_PASSWORD

DATABASE_URL=postgresql+psycopg://nara_runtime:CHANGE_ME_RUNTIME_PASSWORD@db:5432/nara
ALEMBIC_DATABASE_URL=postgresql+psycopg://nara_migrator:CHANGE_ME_MIGRATOR_PASSWORD@db:5432/nara

SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_VALUE
